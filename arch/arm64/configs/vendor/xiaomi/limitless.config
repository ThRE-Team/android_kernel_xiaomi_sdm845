# Limitless Config
CONFIG_LOCALVERSION="-Limitless"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="ThRE"
CONFIG_LIMITLESS=y

# SuSFS v2.4.0
CONFIG_KSU_SUSFS=y
# CONFIG_KSU_SUSFS_SUS_PATH is not set
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
# CONFIG_KSU_SUSFS_OPEN_REDIRECT is not set
CONFIG_KSU_SUSFS_SUS_MAP=y

# Disable LTO
# CONFIG_LTO is not set
# CONFIG_LTO_CLANG is not set
# CONFIG_THINLTO is not set
CONFIG_LTO_NONE=y

# Encryption
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_ALGS=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_F2FS_FS_ENCRYPTION=y
CONFIG_EXT4_ENCRYPTION=y

# Crypto Algorithms
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES_ARM64=y
CONFIG_CRYPTO_AES_ARM64_CE=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_AES_ARM64_NEON_BLK=y

# Other
# CONFIG_RELR is not set
# CONFIG_PANIC_ON_REFCOUNT_ERROR is not set
# CONFIG_SHADOW_CALL_STACK is not set
# CONFIG_PANIC_ON_REBOOT is not set
CONFIG_FUTEX=y
CONFIG_EVENTFD=y
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_CRYPTO_DEFLATE=y
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZ4HC=y
CONFIG_CRYPTO_ZSTD=y
